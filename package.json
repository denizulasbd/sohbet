{
  "name": "sohbet",
  "version": "0.1.0",
  "description": "Minimal AI sohbet uygulaması",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV=1 electron .\"",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && npx --yes electron-builder"
  },
  "build": {
    "appId": "com.deniz.sohbet",
    "productName": "Sohbet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/pdfjs-dist/{build,web,types}/**",
      "!node_modules/pdfjs-dist/legacy/web/**",
      "!node_modules/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sqlite-vec*/**",
      "node_modules/@napi-rs/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/tesseract.js*/**"
    ],
    "win": {
      "target": "nsis",
      "files": [
        "!node_modules/onnxruntime-node/bin/**/darwin/**",
        "!node_modules/onnxruntime-node/bin/**/linux/**"
      ]
    },
    "mac": {
      "target": "dmg",
      "files": [
        "!node_modules/onnxruntime-node/bin/**/linux/**",
        "!node_modules/onnxruntime-node/bin/**/win32/**"
      ]
    },
    "linux": {
      "target": "AppImage",
      "files": [
        "!node_modules/onnxruntime-node/bin/**/darwin/**",
        "!node_modules/onnxruntime-node/bin/**/win32/**"
      ]
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@huggingface/transformers": "^4.3.0",
    "@napi-rs/canvas": "^1.0.10",
    "better-sqlite3": "^12.11.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
